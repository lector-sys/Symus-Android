<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Playback continues with the screen off, which is the whole point of a
         music player; the service declares mediaPlayback so the system knows
         why it is alive. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- 13 and up: without this the media notification simply never appears,
         and playback looks broken rather than un-permitted. Requested at the
         point the user first plays something, not on launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Resuming after a headset reconnects. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".SymusApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SYmuS">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.SYmuS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
