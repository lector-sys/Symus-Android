<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this exists so the window has a background
         before the first frame and the app does not flash white on launch. -->
    <style name="Theme.SYmuS" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
    </style>
</resources>
