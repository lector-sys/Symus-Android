<?xml version="1.0" encoding="utf-8"?>
<!--
    No configuration_optional here, unlike the now-playing widget: a playlist
    shortcut with no playlist chosen has nothing to be a shortcut to, so the
    configuration screen is required before the launcher commits it.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="48dp"
    android:maxResizeWidth="500dp"
    android:maxResizeHeight="300dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_playlist_description"
    android:configure="io.github.lectorsys.symus.widget.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:updatePeriodMillis="0" />
