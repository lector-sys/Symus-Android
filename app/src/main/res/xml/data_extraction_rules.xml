<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the device.

    The library is a local SQLite file and the offline audio is a cache; neither
    belongs in a cloud backup, and a device transfer that carried stale stream
    paths across would be worse than starting clean. allowBackup="false" already
    says this for older versions; this says it for Android 12 and up.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
